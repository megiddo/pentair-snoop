# Default bus connection for pentairsnoop.
# CLI --tcp / --serial / --file always override these values.

# serial (default) or tcp
PENTAIR_TRANSPORT=serial

# Used when PENTAIR_TRANSPORT=serial, or when you pass --serial with no device
PENTAIR_SERIAL_DEVICE=/dev/ttyUSB0
PENTAIR_SERIAL_BAUD=9600

# Used when PENTAIR_TRANSPORT=tcp, or when you pass --tcp with no HOST:PORT
PENTAIR_TCP_HOST=10.0.0.11
PENTAIR_TCP_PORT=8899
